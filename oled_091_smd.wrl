#VRML V2.0 utf8
# 0.91 inch SPI OLED Display Module (128x32 SSD1306)
# Direct SMD / Castellated mount, 2.54mm pitch 6-pin
# VRML Y is inverted relative to KiCad (+Y is UP in VRML, DOWN in KiCad)
# Pad 1 (GND) is at (0, 0, 0)

Group {
  children [
    # 1. Module Substrate (PCB: 38.0mm x 15.1mm x 0.8mm)
    # Centered in X at 18.5, Y at -6.35, Z from 0.0 to 0.8
    Transform {
      translation 18.5 -6.35 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.06 0.12 0.22  # High quality matte dark PCB
              specularColor 0.2 0.2 0.2
              shininess 0.3
            }
          }
          geometry Box {
            size 38.0 15.1 0.8
          }
        }
      ]
    }

    # 2. 6 Gold Castellated / SMD Solder Pads at x=0.0
    # Spaced at 2.54mm intervals downwards: 0.0, -2.54, -5.08, -7.62, -10.16, -12.70
    Transform {
      translation 0.0 0.0 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25  # ENIG Gold
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }
    Transform {
      translation 0.0 -2.54 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }
    Transform {
      translation 0.0 -5.08 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }
    Transform {
      translation 0.0 -7.62 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }
    Transform {
      translation 0.0 -10.16 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }
    Transform {
      translation 0.0 -12.70 0.4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.75 0.25
              specularColor 0.9 0.9 0.5
              shininess 0.9
            }
          }
          geometry Box {
            size 2.6 1.4 0.82
          }
        }
      ]
    }

    # 3. OLED Glass Panel (31.0mm x 12.0mm x 1.0mm)
    Transform {
      translation 20.0 -6.35 1.3
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.02 0.02 0.03  # Glossy dark glass
              specularColor 0.9 0.9 1.0
              shininess 0.95
              transparency 0.05
            }
          }
          geometry Box {
            size 31.0 12.0 1.0
          }
        }
      ]
    }

    # 4. Active OLED Screen Display Area (25.0mm x 7.0mm)
    Transform {
      translation 21.0 -6.35 1.82
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.02 0.06 0.14  # Active matrix OLED panel
              emissiveColor 0.0 0.18 0.40  # Subtle blue glow
              specularColor 0.6 0.6 0.8
              shininess 0.9
            }
          }
          geometry Box {
            size 25.0 7.0 0.04
          }
        }
      ]
    }

    # 5. Realistic display content (white illuminated pixels / test pattern)
    Transform {
      translation 21.0 -6.35 1.84
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.8 0.95 1.0
              emissiveColor 0.7 0.9 1.0    # Bright Crisp OLED white/cyan graphics
              specularColor 1.0 1.0 1.0
              shininess 1.0
            }
          }
          geometry Box {
            size 21.0 4.5 0.02
          }
        }
      ]
    }
  ]
}
